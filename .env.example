# 复制为 .env 后按需填写，只填你要用的那几个即可
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
SILICONFLOW_API_KEY=
MODELSCOPE_API_KEY=
GEMINI_API_KEY=
DASHSCOPE_API_KEY=
ARK_API_KEY=
ZHIPU_API_KEY=

# 腾讯云 COS（做临时图床，给只认公网 URL 的服务商用；region/bucket 在 config.yaml 里配）
COS_SECRET_ID=
COS_SECRET_KEY=

# 对话「联网搜索」工具用的搜索后端（都不填则兜底抓 Bing 网页，可能被限流）
TAVILY_API_KEY=
BOCHA_API_KEY=

# 服务监听
HOST=127.0.0.1
PORT=8000

# 日志：目录默认 data/logs，级别 INFO（DEBUG 会额外记录请求/响应体预览）
# AIHUB_LOG_DIR=
AIHUB_LOG_LEVEL=INFO
